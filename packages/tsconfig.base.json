{
  "compilerOptions": {
    "target": "ESNext",
    "strict": true,
    "skipLibCheck": true,
    "declaration": true,
    "allowSyntheticDefaultImports": true,
    "module": "ESNext",
    "moduleResolution": "Node",
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "emitDeclarationOnly": true,
    "paths": {
      "@excalidraw/basis": ["./basis/src/index.ts"],
      "@excalidraw/basis/*": ["./basis/src/*"],
      "@excalidraw/common": ["./common/src/index.ts"],
      "@excalidraw/common/*": ["./common/src/*"],
      "@excalidraw/element": ["./element/src/index.ts"],
      "@excalidraw/element/*": ["./element/src/*"],
      "@excalidraw/math": ["./math/src/index.ts"],
      "@excalidraw/math/*": ["./math/src/*"],
      "@excalidraw/utils": ["./utils/src/index.ts"],
      "@excalidraw/utils/*": ["./utils/src/*"],
      "@excalidraw/fractional-indexing": ["./fractional-indexing/src/index.ts"],
      "@excalidraw/fractional-indexing/*": ["./fractional-indexing/src/*"],
      "@excalidraw/excalidraw/types": ["./element/src/types_excalidraw.ts"],
      "@excalidraw/excalidraw/components/App": ["./element/src/app-like.ts"],
      "@excalidraw/excalidraw/scene/types": ["./element/src/scene_excalidraw.ts"],
      "@excalidraw/excalidraw/global": ["./basis/global.d.ts"],
      "@excalidraw/excalidraw/css": ["./basis/global.d.ts"]
    }
  }
}
